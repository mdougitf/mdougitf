      "type": "text", "x": 640, "y": 560, "text": "MON TITRE", "size": 80, "tracking": 8, "reveal": 0,
      "animate": { "reveal": [[1.2, 0], [2.0, 1, "linear"]] },
      "effects": [["slide_out", 4.2, 0.5, { "dy": 40 }]]
    },
    {
      "type": "text", "x": 640, "y": 630, "text": "Sous-titre animé en JSON", "size": 26, "font": "regular", "fill": "#cbd5e1",
      "effects": [["slide_in", 2.0, 0.6, { "dy": 30 }], ["fade_out", 4.2, 0.4]]
